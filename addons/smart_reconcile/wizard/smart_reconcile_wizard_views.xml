<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_smart_reconcile_wizard_form" model="ir.ui.view">
        <field name="name">smart.reconcile.wizard.form</field>
        <field name="model">smart.reconcile.wizard</field>
        <field name="arch" type="xml">
            <form string="Match Suggestions">
                <group>
                    <group string="Bank Line">
                        <field name="statement_line_id" readonly="1"/>
                        <field name="payment_ref" readonly="1"/>
                        <field name="partner_name" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="amount" readonly="1"/>
                    </group>
                    <group string="Model">
                        <field name="model_version" readonly="1"/>
                        <field name="threshold" widget="percentage" readonly="1"/>
                    </group>
                </group>
                <div class="alert alert-info" role="status" invisible="suggestion_ids">
                    No matching invoices were found for this line.
                </div>
                <field name="suggestion_ids" nolabel="1" readonly="1">
                    <list decoration-muted="low_confidence" create="0" delete="0">
                        <field name="rank" string="#"/>
                        <field name="partner_id" width="150px"/>
                        <field name="invoice_ids" widget="many2many_tags" width="220px"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="amount_residual"/>
                        <field name="confidence" widget="percentage" invisible="rank != 1"/>
                        <field name="low_confidence" column_invisible="1"/>
                        <field name="reasons"/>
                        <button name="action_accept" type="object" string="Accept" icon="fa-check" class="btn-primary"/>
                        <button name="action_reject" type="object" string="Reject" icon="fa-times"/>
                    </list>
                </field>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
